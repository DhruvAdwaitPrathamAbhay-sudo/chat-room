# Veil — Environment Variables
# Copy to .env and fill in your values. Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/veil

# ── CORS ─────────────────────────────────────────────────────────────────────
# Primary fallback origin for CORS
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (takes precedence over CLIENT_URL)
# Example: http://localhost:3000,https://veil.app
ALLOWED_ORIGINS=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Session ───────────────────────────────────────────────────────────────────
# Must be a long, cryptographically random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-in-production

# ── Authorization ─────────────────────────────────────────────────────────────
# Global Admin Keys required to create a new room (comma-separated).
# These are secrets and must never be exposed.
# Generate with: node -e "console.log('VEIL-' + require('crypto').randomBytes(16).toString('hex'))"
ADMIN_KEYS=VEIL-key1,VEIL-key2,VEIL-key3

