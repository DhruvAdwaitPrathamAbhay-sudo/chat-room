# Veil — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated). Set to your production Vercel URL in production.
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-veil.vercel.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Session ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters long
SESSION_SECRET=your-32-plus-character-session-secret-here

# ── Authorization ─────────────────────────────────────────────────────────────
# Global Admin Keys required to create a new room or clear all rooms (comma-separated).
# Never commit real admin keys to GitHub.
ADMIN_KEYS=VEIL-YOUR-GLOBAL-ADMIN-KEY-1,VEIL-YOUR-GLOBAL-ADMIN-KEY-2

# ── Room Limits & Inactivity ──────────────────────────────────────────────────
MAX_ROOM_MEMBERS=50
ROOM_INACTIVITY_TIMEOUT=30000

# ── Supabase & Authentication (Frontend) ──────────────────────────────────────
# Public Supabase project URL and anonymous publishable API key
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

